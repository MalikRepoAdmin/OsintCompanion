<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OsintCompanion.Views.SocialLookupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Social Lookup">

    <!-- Proper layout grid -->
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="👤 Username Lookup"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Input -->
        <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Entry x:Name="InputEntry"
                   HorizontalOptions="FillAndExpand"
                   Placeholder="Enter username..."
                   Completed="OnEntryCompleted" />
            <Button Text="Search"
                    Clicked="OnSearchClicked"
                    WidthRequest="96" />
        </StackLayout>

        <!-- Loading indicator + status -->
        <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalOptions="FillAndExpand">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               VerticalOptions="Center" />
            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="12"
                   VerticalOptions="Center"
                   TextColor="Gray" />
        </StackLayout>

        <!-- Results -->
        <CollectionView Grid.Row="3"
                        x:Name="ResultContainer"
                        SelectionMode="None"
                        VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Margin="0,6,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6"
                           Padding="10"
                           BorderColor="#DDD"
                           CornerRadius="8"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Platform}" FontAttributes="Bold" />
                            <Label Text="{Binding Url}" FontSize="12" TextColor="#555" />
                            <Label Text="{Binding Exists, StringFormat='Found: {0}'}" FontSize="12" />
                            <Label Text="{Binding ExtraInfo}" FontSize="12" TextColor="#666" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Debug log viewer -->
        <ScrollView Grid.Row="4"
                    HeightRequest="120"
                    BackgroundColor="#111111"
                    Padding="8"
                    VerticalOptions="End">
            <Label x:Name="DebugLabel"
                   Text="Debug output will appear here"
                   FontSize="12"
                   TextColor="#cccccc"
                   LineBreakMode="WordWrap" />
        </ScrollView>

    </Grid>
</ContentPage>
