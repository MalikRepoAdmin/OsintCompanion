<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OsintCompanion.Views.SocialLookupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Social Lookup">


    <Shell.NavBarIsVisible>True</Shell.NavBarIsVisible>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="True" IsEnabled="True" />
    </Shell.BackButtonBehavior>


    <!-- 2. Create a custom TitleView containing our custom back button and Title -->
    <Shell.TitleView>
        <HorizontalStackLayout HeightRequest="50" 
                               Spacing="10" 
                               Padding="10,0"
                               BackgroundColor="Transparent" >
            
            <!-- Custom Back Button (Clean Styling Restored) -->
            <ImageButton x:Name="CustomBackButton"
                         WidthRequest="40"
                         HeightRequest="40"
                         Source="arrowaltsquareleft.png"
                         BackgroundColor="#363E43" 
                         CornerRadius="6"
                         Padding="6"
                         VerticalOptions="Center" 
                         HorizontalOptions="Start"
                         Aspect="AspectFit"
                         Clicked="CustomBackButton_Clicked">
                <ImageButton.Shadow>
                    <Shadow Brush="Black" Radius="8" Opacity="0.2" Offset="1,1" />
                </ImageButton.Shadow>
            </ImageButton>

            <!-- Page Title -->
            <Label x:Name="PageTitleLabel" 
                   Text="{Binding Title}" 
                   TextColor="AntiqueWhite"
                   FontFamily="PoppinsRegular"
                   FontSize="14" 
                   VerticalOptions="Center" 
                   HorizontalOptions="End" />

            <!-- Placeholder for other toolbar items if needed -->
            
        </HorizontalStackLayout>
    </Shell.TitleView>


    <!-- Proper layout grid -->
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="👤 Username Lookup"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Input -->
        <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Entry x:Name="InputEntry"
                   HorizontalOptions="FillAndExpand"
                   Placeholder="Enter username..."
                   Completed="OnEntryCompleted" />

            <!--New Entry for API Keys Input (Advanced Mode)-->
            <Entry  x:Name="AdvancedAPISocial"
                    Placeholder="Enter API Key...(Optional)"/>
            
            <Button Text="Search"
                    Clicked="OnSearchClicked"
                    WidthRequest="96" />
        </StackLayout>

        <!-- Loading indicator + status -->
        <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalOptions="FillAndExpand">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               VerticalOptions="Center" />
            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="12"
                   VerticalOptions="Center"
                   TextColor="Gray" />
        </StackLayout>

        <!-- Results -->
        <CollectionView Grid.Row="3"
                        x:Name="ResultContainer"
                        SelectionMode="None"
                        VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Margin="0,6,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6"
                           Padding="10"
                           BorderColor="#DDD"
                           CornerRadius="8"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Platform}" FontAttributes="Bold" />
                            <Label Text="{Binding Url}" FontSize="12" TextColor="#555" />
                            <Label Text="{Binding Exists, StringFormat='Found: {0}'}" FontSize="12" />
                            <Label Text="{Binding ExtraInfo}" FontSize="12" TextColor="#666" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Debug log viewer -->
        <ScrollView Grid.Row="4"
                    HeightRequest="120"
                    BackgroundColor="#111111"
                    Padding="8"
                    VerticalOptions="End">
            <Label x:Name="DebugLabel"
                   Text="Debug output will appear here"
                   FontSize="12"
                   TextColor="#cccccc"
                   LineBreakMode="WordWrap" />
        </ScrollView>

    </Grid>
</ContentPage>
