<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OsintCompanion.Views.MetadataPage"
             Title="Metadata Lookup">


    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="True" IsEnabled="True" />
    </Shell.BackButtonBehavior>


    <!-- 2. Create a custom TitleView containing our custom back button and Title -->
    <Shell.TitleView>
        <HorizontalStackLayout HeightRequest="50" 
                               Spacing="10" 
                               Padding="10,0"
                               BackgroundColor="Transparent" >
            
            <!-- Custom Back Button (Clean Styling Restored) -->
            <ImageButton x:Name="CustomBackButton"
                         WidthRequest="40"
                         HeightRequest="40"
                         Source="arrowaltsquareleft.png"
                         BackgroundColor="#363E43" 
                         CornerRadius="6"
                         Padding="6"
                         VerticalOptions="Center" 
                         HorizontalOptions="Start"
                         Aspect="AspectFit"
                         Clicked="CustomBackButton_Clicked">
                <ImageButton.Shadow>
                    <Shadow Brush="Black" Radius="8" Opacity="0.2" Offset="1,1" />
                </ImageButton.Shadow>
            </ImageButton>

            <!-- Page Title -->
            <Label x:Name="PageTitleLabel" 
                   Text="{Binding Title}" 
                   TextColor="AntiqueWhite"
                   FontFamily="PoppinsRegular"
                   FontSize="14" 
                   VerticalOptions="Center" 
                   HorizontalOptions="End" />

            <!-- Placeholder for other toolbar items if needed -->
            
        </HorizontalStackLayout>
    </Shell.TitleView>



    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

        <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <!-- Input for URL or file path -->
            <Entry x:Name="InputEntry"
                Placeholder='Enter URL or file path (e.g "C:\Users\user\Pictures\Untitled59_20240201105840.png" )'
                HorizontalOptions="FillAndExpand"
                FontSize="14"
                Keyboard="Url"
                Completed="OnEntryCompleted"/>

            <!--New Entry for API Keys Input (Advanced Mode)-->
            <Entry  x:Name="AdvancedAPIMetadata"
                    Placeholder="Enter API Key...(Optional)"/>

            <Button Text="Extract Metadata"
                    Clicked="OnExtractClicked"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    WidthRequest="96"/>
        </StackLayout>


        <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Border StrokeThickness="2"
                    Stroke="#4a4a4a">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10,10,10,10"/>
                    </Border.StrokeShape>
            <!-- Log/Output area -->

            <ScrollView HeightRequest="240"
                        BackgroundColor="#111111"
                        Padding="8">

                <Label x:Name="OutputLabel"
                    Text="Ready... (Output Will Shown Here)"
                    TextColor="#cccccc"
                    FontFamily="Consolas"
                    LineBreakMode="WordWrap"/>
            </ScrollView>
            </Border>
        </StackLayout>

    </Grid>
</ContentPage>
