<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OsintCompanion.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OsintCompanion.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#141414}">

    <TabBar>
        <Tab Title="Main Page" Route="mainroute" Icon="networkanalytic.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:A1MainMenu}"/>
        </Tab>
        <Tab Title="Case" Route="caseroute"  Icon="drawerempty.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:A2CasePage}"/>
        </Tab>
        <Tab Title="Visual" Route="visualroute" Icon="organizationchart.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:A3VisualPage}"/>
        </Tab>
        <Tab Title="Notes" Route="notesroute" Icon="circlenodes.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:NotesPage}"/>
        </Tab>
    </TabBar>

</Shell>
