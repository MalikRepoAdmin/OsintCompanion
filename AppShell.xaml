<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OsintCompanion.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OsintCompanion.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <TabBar>
        <Tab Title="Main Page" Icon="networkanalytic.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:A1MainMenu}"/>
        </Tab>
        <Tab Title="Social" Icon="networkuser.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:SocialLookupPage}"/>
        </Tab>
        <Tab Title="Metadata" Icon="termsinfo.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:MetadataPage}"/>
        </Tab>
        <Tab Title="Notes" Icon="circlenodes.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:NotesPage}"/>
        </Tab>
    </TabBar>

</Shell>
